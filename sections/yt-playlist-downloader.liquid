{%- comment -%} Interface perso : colle un lien de playlist YouTube, clique Télécharger. Nécessite le serveur local tools/yt-downloader. {%- endcomment -%}
<div class="ytd" id="ytd-{{ section.id }}" data-server="{{ section.settings.server_url | escape }}" data-token="{{ section.settings.token | escape }}">
  <h1 class="ytd__title">{{ section.settings.title | escape }}</h1>
  <input class="ytd__input" type="url" placeholder="https://www.youtube.com/playlist?list=..." autocomplete="off">
  <div class="ytd__row">
    <button class="ytd__btn" type="button">Télécharger en MP3</button>
  </div>
  <p class="ytd__status" aria-live="polite"></p>
</div>

<style>
.ytd{max-width:560px;margin:80px auto;padding:32px;background:#0b0b0b;border:1px solid #222;border-radius:16px;color:#fff}
.ytd__title{font-size:22px;margin:0 0 20px;letter-spacing:.06em;text-transform:uppercase}
.ytd__input{width:100%;box-sizing:border-box;padding:14px;background:#000;color:#fff;border:1px solid #333;border-radius:10px;font-size:15px}
.ytd__row{display:flex;gap:10px;margin-top:12px}
.ytd__btn{flex:1;padding:14px;background:#e11d2e;color:#fff;border:0;border-radius:10px;font-weight:700;cursor:pointer}
.ytd__btn:disabled{opacity:.5;cursor:wait}
.ytd__status{margin:14px 0 0;font-size:14px;color:#aaa;min-height:1.2em}
</style>

<script>
(function(){
  var root=document.getElementById('ytd-{{ section.id }}');
  var input=root.querySelector('.ytd__input'),btn=root.querySelector('.ytd__btn'),
      st=root.querySelector('.ytd__status');
  btn.addEventListener('click',async function(){
    var url=input.value.trim();
    if(!/^https?:\/\/(www\.|music\.)?(youtube\.com|youtu\.be)\//.test(url)){st.textContent='Lien YouTube invalide.';return;}
    btn.disabled=true;st.textContent='Téléchargement en cours… (peut durer plusieurs minutes)';
    try{
      var r=await fetch(root.dataset.server.replace(/\/$/,'')+'/download',{
        method:'POST',headers:{'Content-Type':'application/json','X-Token':root.dataset.token},
        body:JSON.stringify({url:url,format:'mp3'})});
      if(!r.ok)throw new Error((await r.text())||r.status);
      var b=await r.blob(),a=document.createElement('a');
      a.href=URL.createObjectURL(b);a.download='playlist.zip';a.click();
      st.textContent='Terminé ✔';
    }catch(e){st.textContent='Erreur : '+e.message+' (le serveur est-il lancé ?)';}
    btn.disabled=false;
  });
})();
</script>

{% schema %}
{
  "name": "YT Playlist Downloader",
  "settings": [
    {"type":"text","id":"title","label":"Titre","default":"Playlist YouTube → MP3"},
    {"type":"text","id":"server_url","label":"URL du serveur","default":"http://localhost:5000"},
    {"type":"text","id":"token","label":"Mot de passe du serveur (optionnel)"}
  ],
  "presets": [{"name":"YT Playlist Downloader"}]
}
{% endschema %}
