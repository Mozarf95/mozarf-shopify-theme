<div class="album-header">
  <h1 class="album-header__title">{{ collection.title }}</h1>
  <div class="album-header__filters">
    <a href="/collections/all" class="filter-pill {% if current_tags == blank %}filter-pill--active{% endif %}">TOUT</a>
    <a href="/collections/all/singles" class="filter-pill {% if current_tags contains 'single' %}filter-pill--active{% endif %}">SINGLES</a>
    <a href="/collections/album" class="filter-pill {% if collection.handle == 'album' %}filter-pill--active{% endif %}">ALBUMS</a>
  </div>
</div>

<style>
.album-header {
  padding: 24px 32px 0;
  background: #000;
}
.album-header__title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #fff;
  margin-bottom: 16px;
}
.album-header__filters {
  display: flex;
  gap: 8px;
  margin-bottom: 24px;
}
.filter-pill {
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #fff;
  text-decoration: none;
  border: 1px solid #333;
  transition: all 0.2s;
}
.filter-pill--active {
  background: #c8f000;
  color: #000;
  border-color: #c8f000;
}
.filter-pill:hover:not(.filter-pill--active) {
  border-color: #666;
}
</style>
{% schema %}
{
  "name": "Album Header",
  "settings": []
}
{% endschema %}
