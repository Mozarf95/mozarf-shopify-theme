<div id="mozarf-player" class="mozarf-sp" aria-hidden="true">
  <div class="mozarf-sp__drawer" id="mozarf-player-drawer" aria-label="Playlist">
    <div class="mozarf-sp__drawer-head">
      <div>
        <p class="mozarf-sp__eyebrow">Now Playing</p>
        <h2 class="mozarf-sp__title" id="mozarf-player-album-title">MOZARF</h2>
        <p class="mozarf-sp__artist" id="mozarf-player-album-artist">Selectionnez une piste</p>
      </div>
      <button type="button" class="mozarf-sp__drawer-close" id="mozarf-player-drawer-close" aria-label="Replier la playlist">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.3 5.71 12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.29 19.71 2.88 18.3 9.17 12 2.88 5.71 4.29 4.29l6.3 6.3 6.29-6.3z"/></svg>
      </button>
    </div>
    <div class="mozarf-sp__list-head">
      <span>#</span>
      <span>Titre</span>
      <span>Achat</span>
    </div>
    <ul id="mozarf-player-tracklist" class="mozarf-sp__tracklist" role="list"></ul>
  </div>

  <div class="mozarf-sp__bar" role="region" aria-label="Lecteur audio" style="position:relative">
    <div class="mozarf-sp__left">
      <a id="mozarf-player-cover-link" href="#" class="mozarf-sp__cover-link" aria-label="Ouvrir la page de l’album">
        <img id="mozarf-player-cover" class="mozarf-sp__cover" src="" alt="" width="56" height="56" loading="lazy">
      </a>
      <div class="mozarf-sp__meta">
        <div class="mozarf-sp__meta-title" id="mozarf-player-meta-title">—</div>
        <div class="mozarf-sp__meta-artist" id="mozarf-player-meta-artist">MOZARF</div>
      </div>
    </div>

    <div class="mozarf-sp__center">
      <div class="mozarf-sp__controls">
        <button type="button" class="mozarf-sp__btn" id="mozarf-player-prev" aria-label="Piste precedente" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 6h2v12H6V6zm3.5 6L18 6v12l-8.5-6z"/></svg>
        </button>
        <button type="button" class="mozarf-sp__btn mozarf-sp__btn--play" id="mozarf-player-play" aria-label="Lecture / Pause" disabled>
          <span class="mozarf-sp__icon-play" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
          <span class="mozarf-sp__icon-pause" aria-hidden="true" style="display:none">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          </span>
        </button>
        <button type="button" class="mozarf-sp__btn" id="mozarf-player-next" aria-label="Piste suivante" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 6h2v12h-2V6zM6 18V6l8.5 6L6 18z"/></svg>
        </button>
      </div>
      <div class="mozarf-sp__progress">
        <span class="mozarf-sp__time" id="mozarf-player-time-cur">0:00</span>
        <input type="range" id="mozarf-player-seek" min="0" max="1000" value="0" aria-label="Position du morceau">
        <span class="mozarf-sp__time" id="mozarf-player-time-dur">0:00</span>
      </div>
    </div>

    <div class="mozarf-sp__right">
      <div class="mozarf-sp__vol">
        <label class="mozarf-sp__vol-label" for="mozarf-player-volume">Vol</label>
        <input type="range" id="mozarf-player-volume" min="0" max="1" step="0.05" value="1" aria-label="Volume">
      </div>
      <button type="button" class="mozarf-sp__btn mozarf-sp__btn--queue" id="mozarf-player-queue" aria-label="Afficher la playlist">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 6h14v2H3V6zm0 5h14v2H3v-2zm0 5h10v2H3v-2zm16-7v6l5-3-5-3z"/></svg>
      </button>
      <button type="button" class="mozarf-sp__btn mozarf-sp__btn--close" id="mozarf-player-close" aria-label="Masquer le lecteur">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.3 5.71 12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.29 19.71 2.88 18.3 9.17 12 2.88 5.71 4.29 4.29l6.3 6.3 6.29-6.3z"/></svg>
      </button>
    </div>
  </div>

  <audio id="mozarf-player-audio" preload="metadata"></audio>

  <div id="mozarf-sp-preview-gate" hidden>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    <span class="mozarf-sp-gate__label">PRÉCOUTE TERMINÉE</span>
    <a href="#" class="mozarf-sp-gate__buy" target="_blank" rel="noopener">ACHETER L'ALBUM</a>
    <button type="button" class="mozarf-sp-gate__replay" id="mozarf-sp-gate-replay">← REJOUER</button>
  </div>
</div>

{{ 'mozarf-player.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mozarf-player.js' | asset_url }}" defer></script>
