{%- comment -%}
  JSON album + contexte produit pour le lecteur sticky (unwrap côté JS).
  Paramètre : product
{%- endcomment -%}
{% capture _mozarf_album_core %}
  {% render 'mozarf-album-json', product: product %}
{% endcapture %}
{% liquid
  if product.featured_image != blank
    assign cover_u = product.featured_image | image_url: width: 600
  else
    assign cover_u = ''
  endif
%}
{% capture _mozarf_album_out %}
{
  "product_url": {{ product.url | json }},
  "vendor": {{ product.vendor | json }},
  "product_title": {{ product.title | json }},
  "cover_shopify": {{ cover_u | json }},
  "album": {{ _mozarf_album_core | strip }}
}
{% endcapture %}
{{- _mozarf_album_out | strip | replace: '</script', '<\/script' | replace: '</Script', '<\/script' -}}
